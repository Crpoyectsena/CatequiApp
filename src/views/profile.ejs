<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Tu perfil de usuario en CatequiApp">
  <title>Mi perfil | CatequiApp</title>
  <link rel="stylesheet" href="/styles/app.css">
  <link rel="stylesheet" href="/styles/profile.css" type="text/css">
  <link rel="stylesheet" href="/styles/navigation.css">
  <script defer src="/js/profile.js"></script>
</head>

<body class="with-sidebar">
  <%- include('partials/sidebar', { activeModule: 'profile', userRole }) %>
  <main class="profile-container">
    <section class="card profile-header">
      <div class="profile-project-logo" aria-label="Logo de CatequiApp">
        <span class="brand-mark auth-logo" aria-hidden="true">C</span>
      </div>
      <h1 class="profile-title"><%= [userData.firstName, userData.middleName, userData.firstLastName, userData.secondLastName].filter(Boolean).join(' ') %></h1>
      <p class="profile-role"><%= userData.role %></p>
      <p class="profile-subtitle">Consulta y actualiza tu información personal.</p>
    </section>

    <section class="card profile-details">
      <div class="profile-section-heading">
        <h2 class="section-title">Información personal</h2>
        <button class="profile-edit-button" type="button" id="edit-profile">Editar</button>
      </div>
      <div class="details-grid">
        <div class="detail-item">
          <span class="detail-label">Usuario:</span>
          <span class="detail-value"><%= userData.userName || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Correo:</span>
          <span class="detail-value"><%= userData.email || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Teléfono:</span>
          <span class="detail-value"><%= userData.phone || '—' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Dirección:</span>
          <span class="detail-value"><%= userData.address || '—' %></span>
        </div>
      </div>

      <form class="profile-edit-form" id="profile-form" hidden>
        <div class="details-grid">
          <label class="profile-field" for="first-name">Primer nombre
            <input id="first-name" name="firstName" type="text" maxlength="50" value="<%= userData.firstName || '' %>" required>
          </label>
          <label class="profile-field" for="middle-name">Segundo nombre
            <input id="middle-name" name="middleName" type="text" maxlength="50" value="<%= userData.middleName || '' %>">
          </label>
          <label class="profile-field" for="first-last-name">Primer apellido
            <input id="first-last-name" name="firstLastName" type="text" maxlength="50" value="<%= userData.firstLastName || '' %>" required>
          </label>
          <label class="profile-field" for="second-last-name">Segundo apellido
            <input id="second-last-name" name="secondLastName" type="text" maxlength="50" value="<%= userData.secondLastName || '' %>">
          </label>
          <label class="profile-field" for="profile-email">Correo electrónico
            <input id="profile-email" name="email" type="email" maxlength="100" value="<%= userData.email || '' %>" required>
          </label>
          <label class="profile-field" for="profile-phone">Teléfono
            <input id="profile-phone" name="phone" type="tel" maxlength="20" value="<%= userData.phone || '' %>">
          </label>
          <label class="profile-field profile-field-wide" for="profile-address">Dirección
            <input id="profile-address" name="address" type="text" maxlength="255" value="<%= userData.address || '' %>">
          </label>
        </div>
        <p class="profile-feedback" id="profile-feedback" role="status" aria-live="polite"></p>
        <div class="profile-form-actions">
          <button class="profile-quiet-button" type="button" id="cancel-profile">Cancelar</button>
          <button class="profile-edit-button" type="submit" id="save-profile">Guardar</button>
        </div>
      </form>
    </section>

    <footer class="profile-footer">
      <p>© <%= new Date().getFullYear() %> CatequiApp</p>
    </footer>
  </main>
</body>

</html>
